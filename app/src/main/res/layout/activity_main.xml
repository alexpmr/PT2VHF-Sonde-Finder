<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- App bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_logo"
            android:contentDescription="@null"
            android:padding="7dp"
            android:src="@drawable/ic_antenna"
            android:tint="@color/bg" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- "PT2VHF Sonde Finder 1.11.0" (version filled in by MainActivity) -->
            <TextView
                android:id="@+id/appTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:text="PT2VHF Sonde Finder"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_live"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <View
                android:id="@+id/liveDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/dot" />

            <TextView
                android:id="@+id/liveText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/connecting"
                android:textColor="#7BEFAE"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:layout_marginStart="2dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_title"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings"
            android:tint="@color/text2" />

        <ImageButton
            android:id="@+id/btnAbout"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="-8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/about_title"
            android:src="@drawable/ic_info"
            android:tint="@color/text2" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E2830" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ============ MAP SCREEN ============ -->
        <LinearLayout
            android:id="@+id/mapScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <org.maplibre.android.maps.MapView
                    android:id="@+id/map"
                    app:maplibre_renderTextureMode="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_overlay"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:id="@+id/chipArrow"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_nav_up"
                        android:tint="@color/blue" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/chipDist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="— km"
                            android:textColor="@color/text"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipBearing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/waiting_gps_lc"
                            android:textColor="@color/muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/btnFilter"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_overlay_btn"
                        android:drawableStart="@drawable/ic_tune"
                        android:drawablePadding="6dp"
                        android:drawableTint="@color/text"
                        android:fontFamily="monospace"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="12dp"
                        android:text="100 km · 6 h"
                        android:textColor="@color/text"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnList"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_overlay_btn"
                        android:drawableStart="@drawable/ic_list"
                        android:drawablePadding="6dp"
                        android:drawableTint="@color/text"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="12dp"
                        android:text="@string/zero_sondes"
                        android:textColor="@color/text"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnOrient"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_overlay_btn"
                        android:contentDescription="@string/map_orientation_desc"
                        android:src="@drawable/ic_north" />

                    <ImageButton
                        android:id="@+id/btnSound"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_overlay_btn"
                        android:contentDescription="@string/detector_desc"
                        android:src="@drawable/ic_sound"
                        android:tint="@color/text" />

                    <ImageButton
                        android:id="@+id/btnMapStyle"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_overlay_btn"
                        android:contentDescription="@string/map_settings_title"
                        android:src="@drawable/ic_brightness"
                        android:tint="@color/text" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnCenter"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="36dp"
                    android:background="@drawable/bg_blue_btn"
                    android:contentDescription="@string/center_desc"
                    android:src="@drawable/ic_center"
                    android:tint="@color/bg" />
            </FrameLayout>

            <!-- Bottom sheet -->
            <!-- Tap the handle to collapse/expand: collapsed keeps only the serial/age row. -->
            <LinearLayout
                android:id="@+id/sheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-24dp"
                android:background="@drawable/bg_panel"
                android:elevation="8dp"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="0dp"
                android:paddingEnd="18dp"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:id="@+id/sheetHandle"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/sheet_toggle">

                    <View
                        android:layout_width="40dp"
                        android:layout_height="4dp"
                        android:layout_gravity="center"
                        android:background="#3A4752" />

                    <TextView
                        android:id="@+id/sheetChevron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:text="▾"
                        android:textColor="@color/muted"
                        android:textSize="16sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/modeLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.08"
                                android:text="@string/mode_auto"
                                android:textColor="@color/muted"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/btnAuto"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_chip_off"
                                android:paddingStart="8dp"
                                android:paddingTop="2dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="2dp"
                                android:text="@string/back_to_auto"
                                android:textColor="@color/accent_soft"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/serial"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="—"
                                android:textColor="@color/text"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/stype"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:paddingBottom="2dp"
                                android:textColor="@color/text2"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge"
                        android:letterSpacing="0.05"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="5dp"
                        android:text="—"
                        android:textColor="@color/accent_soft"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- last packet -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_inset"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <View
                        android:id="@+id/freshDot"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:background="@drawable/dot" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/last_packet"
                        android:textColor="@color/text2"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/age"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:text="—"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/via"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:maxWidth="160dp"
                        android:maxLines="1"
                        android:textColor="@color/muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/warn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/amber"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <!-- stats -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/StatCard">
                        <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/altitude" />
                        <TextView android:id="@+id/vAlt" style="@style/Value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatCard" android:layout_marginStart="8dp">
                        <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/vel_vertical" />
                        <TextView android:id="@+id/vVv" style="@style/Value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatCard" android:layout_marginStart="8dp">
                        <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/vel_horizontal" />
                        <TextView android:id="@+id/vVh" style="@style/Value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/StatCard">
                        <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/heading_lbl" />
                        <TextView android:id="@+id/vHead" style="@style/Value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatCard" android:layout_marginStart="8dp">
                        <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/frequency" />
                        <TextView android:id="@+id/vFreq" style="@style/Value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatCard" android:layout_marginStart="8dp">
                        <TextView android:id="@+id/vEtaLabel" style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/landing_in" />
                        <TextView android:id="@+id/vEta" style="@style/Value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" />
                    </LinearLayout>
                </LinearLayout>

                <!-- landing place as street, neighbourhood, city -->
                <TextView
                    android:id="@+id/vPlaceLabel"
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/landing_place" />

                <TextView
                    android:id="@+id/vPlace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="—"
                    android:textColor="@color/text"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/StatCard">
                        <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/temperature" />
                        <TextView android:id="@+id/vTemp" style="@style/Value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatCard" android:layout_marginStart="8dp">
                        <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pressure" />
                        <TextView android:id="@+id/vPress" style="@style/Value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" />
                    </LinearLayout>
                </LinearLayout>

                <!-- coords -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/last_position"
                            android:textColor="@color/muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/coords"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="—"
                            android:textColor="@color/text"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnCopy"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_outline_btn"
                        android:contentDescription="@string/copy_coords"
                        android:src="@drawable/ic_copy"
                        android:tint="@color/text" />

                    <LinearLayout
                        android:id="@+id/btnNav"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_accent_btn"
                        android:clickable="true"
                        android:contentDescription="@string/navigate_desc"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_nav"
                            android:tint="@color/bg" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/navigate"
                            android:textColor="@color/bg"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ============ COMPASS SCREEN ============ -->
        <LinearLayout
            android:id="@+id/compassScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_seg"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/segLast"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/last_position"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/segLand"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/predicted_landing"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cSerial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="—"
                    android:textColor="@color/text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cType"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <View
                    android:id="@+id/cFreshDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot" />

                <TextView
                    android:id="@+id/cAge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="monospace"
                    android:text="—"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.pt2vhf.sondefinder.CompassView
                android:id="@+id/compass"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/cCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="@string/to_last_position"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cDist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:text="—"
                    android:textColor="@color/text"
                    android:textSize="42sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="monospace"
                    android:paddingBottom="4dp"
                    android:text="km"
                    android:textColor="@color/text2"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- target place (street, neighbourhood, city); the textual bearing line was removed -->
            <TextView
                android:id="@+id/cPlace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/text2"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/cBearing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnHeadingMode"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_chip_off"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/text2"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cWarn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/amber"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnDetector"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_outline_btn"
                android:gravity="center"
                android:text="@string/detector_off"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <LinearLayout style="@style/StatCard">
                    <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/altitude" />
                    <TextView android:id="@+id/cAlt" style="@style/Value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="15sp" />
                    <TextView android:id="@+id/cVv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:textColor="@color/accent_soft" android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout style="@style/StatCard" android:layout_marginStart="8dp">
                    <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/elevation" />
                    <TextView android:id="@+id/cElev" style="@style/Value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="15sp" />
                    <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/for_antenna" />
                </LinearLayout>

                <LinearLayout style="@style/StatCard" android:layout_marginStart="8dp">
                    <TextView android:id="@+id/cEtaLabel" style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/landing_in" />
                    <TextView android:id="@+id/cEta" style="@style/Value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="15sp" />
                    <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/forecast" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom nav -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/bg"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="6dp"
        android:paddingEnd="24dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/navMap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navMapIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_map" />

            <TextView
                android:id="@+id/navMapText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_map"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCompass"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navCompassIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_compass" />

            <TextView
                android:id="@+id/navCompassText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_compass"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
